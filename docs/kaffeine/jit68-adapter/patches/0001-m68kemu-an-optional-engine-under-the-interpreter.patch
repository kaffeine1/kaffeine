 };
 
 
@@ -347,6 +372,17 @@ void  M68KEmu_FreeNestCpus(struct M68KEmuContext *ctx, struct M68KTaskState *ts)
 void  M68KEmu_StopCpu(struct M68KEmuContext *ctx, void *cpu);
