 rom/m68kemu/m68kemu_intern.h        |  36 ++++
 rom/m68kemu/m68kemu_jit.c           | 290 ++++++++++++++++++++++++++++
 rom/m68kemu/m68kemu_m68klib.c       |   1 +
 rom/m68kemu/m68kemu_memory.c        |   8 +
 rom/m68kemu/m68kemu_moira.cpp       | 275 +++++++++++++++++++++++++-
 rom/m68kemu/m68kemu_run.c           |  17 +-
 rom/m68kemu/m68kemu_thunks.c        |   2 +
 rom/m68kemu/mmakefile.src           |   1 +
