+    names = ['m68k_in_mem', 'm68k_read16', 'm68k_read32']
+    if re.search(r'^static inline BOOL m68k_write_allowed\s*\(', source, re.M):
+        names.append('m68k_write_allowed')
+    names += ['m68k_write16', 'm68k_write32']
