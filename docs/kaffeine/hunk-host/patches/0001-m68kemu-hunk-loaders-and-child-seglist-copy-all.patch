+/* the row of the fixture's heap that was allocated at this address */
+static unsigned row_of(ULONG addr)
+{
+    unsigned i;
+
+    for (i = 0; i < heap_blocks; i++)
+    {
+        if (blocks[i].addr == addr)
+            return i;
+    }
+    return BLOCKS;
