+    The production loader of hunk files, M68KEmu_LoadHunksFromMemory(), on
+    well-formed and on malformed files. The heap is a recording fixture; no
+    CPU runs. This is not an AROS image test.
+*/
+#include <algorithm>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <functional>
+#include <initializer_list>
+#include <map>
