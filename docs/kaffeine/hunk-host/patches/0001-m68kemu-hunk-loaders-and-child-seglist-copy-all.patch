+/* CreateNewProc as the program calls it: D1, the tag list */
+static ULONG create_new(struct M68KEmuContext *ctx)
+{
+    memset(regs, 0, sizeof(regs));
+    regs[1] = TAGS;
+    return (ULONG)m68k_dos_CreateNewProc(ctx, regs);
+}
