#
# kaffeine.library — Transparent M68K emulation for AmigaOS hunk binaries
# Moira by default, with an opt-in experimental AArch64 JIT
#
# Skip on m68k targets — no need to emulate m68k on m68k
#
# The checked-in kaffeine_shadow_layouts.h holds the native struct offsets of a
# 64bit build (an_Parent is at 8 there, but at 4 on a 32bit target), so only
# build where those are valid until the layouts are generated per target.

include $(SRCDIR)/config/aros.cfg

#MM- kernel-kaffeine : kernel-kaffeine-$(AROS_TARGET_CPU)
#MM- kernel-kaffeine-x86_64 : kernel-kaffeine-library
#MM- kernel-kaffeine-aarch64 : kernel-kaffeine-library
#MM- kernel-kaffeine-riscv64 : kernel-kaffeine-library

USER_CPPFLAGS := -DNO_INLINE_STDARG -I$(SRCDIR)/$(CURDIR)/Moira
# Moira uses if constexpr (<integer>) - narrowing the condition to bool is only
# well formed since P1401R5, which clang implements from 12 on (clang 11 errors).
USER_CXXFLAGS := $(CXXFLAGS_CXX20) $(NOWARN_NARROWING)
USER_LDFLAGS := -static

KAFFEINE_FILES := \
    kaffeine_init \
    kaffeine_run \
    kaffeine_cpu \
    kaffeine_jit \
    kaffeine_sched \
    kaffeine_hook \
    kaffeine_format \
    kaffeine_dispatch \
    kaffeine_memory \
    kaffeine_remember \
    kaffeine_segments \
    kaffeine_process_tags \
    kaffeine_domain_run \
    kaffeine_domain_process \
    kaffeine_domain_modules \
    kaffeine_dos_broker \
    kaffeine_socket \
    kaffeine_system_path kaffeine_intuibase kaffeine_cgx_read kaffeine_socket_native \
    kaffeine_thunks \
    kaffeine_thunks_memory \
    kaffeine_lists \
    kaffeine_memheader \
    kaffeine_thunks_dos \
    kaffeine_thunks_utility \
    kaffeine_thunks_locale \
    kaffeine_taglist \
    kaffeine_thunks_mathieee \
    kaffeine_thunks_mathffp \
    kaffeine_thunks_gfx \
    kaffeine_p96 \
    kaffeine_asl \
    kaffeine_thunks_diskfont \
    kaffeine_icon \
    kaffeine_display \
    kaffeine_fontattr \
    kaffeine_rastport \
    kaffeine_gfxbase \
    kaffeine_window \
    kaffeine_menus \
    kaffeine_gadgets \
    kaffeine_screens \
    kaffeine_owned_screens \
    kaffeine_palette \
    kaffeine_videocontrol \
    kaffeine_layers \
    kaffeine_paint_compile \
    kaffeine_paint_hook \
    kaffeine_regions \
    kaffeine_mirror \
    kaffeine_copy \
    kaffeine_classic \
    kaffeine_requester \
    kaffeine_readargs \
    kaffeine_cli \
    kaffeine_exec_compat \
    kaffeine_messages \
    kaffeine_filehandle \
    kaffeine_locks \
    kaffeine_thunks_locks \
    kaffeine_handlers \
    kaffeine_exec_io \
    kaffeine_thunks_timer \
    kaffeine_thunks_console \
    kaffeine_keymap \
    kaffeine_shadow \
    kaffeine_m68klib \
    kaffeine_workbench \
    kaffeine_startup \
    kaffeine_stubs \
    kaffeine_thunks_gen

KAFFEINE_CXXFILES := \
    kaffeine_moira \
    Moira/Moira/Moira \
    Moira/Moira/MoiraDebugger

%build_module mmake=kernel-kaffeine-library \
    modname=kaffeine modtype=library \
    files="$(KAFFEINE_FILES)" \
    cxxfiles="$(KAFFEINE_CXXFILES)" \
    uselibs="stdc++ posixc stdcio stdc"

# The dependency file of the C++ wrapper. scripts/mkdep pipes the compiler
# into sed, so a Makedepend that fails, as it does while the Moira
# submodule is not checked out, still leaves an empty .d without an error.
# That file then counts as current, and kaffeine_moira.o, which reads the
# KaffeineContext through kaffeine_intern.h, is never rebuilt for a header
# change again. Run Makedepend again whenever a Kaffeine or Moira header it
# can include is newer than the .d, so that the object gets its real
# prerequisites back. The Moira objects keep their own dependency files.
$(kernel-kaffeine-library_OBJDIR)/kaffeine_moira.d : \
    $(wildcard $(SRCDIR)/$(CURDIR)/kaffeine_*.h) \
    $(wildcard $(SRCDIR)/$(CURDIR)/Moira/Moira/*.h)

%common

# ── Shadow layout regeneration (needed for any new target architecture) ──
# The checked-in kaffeine_shadow_layouts.h was generated for x86_64.
# To regenerate it, compile the probe gen_offset_extractor.py writes with both
# the m68k and the target compiler, then feed the two offset dumps to
#   gen_shadow_layouts.py m68k.txt aros.txt > kaffeine_shadow_layouts.h
# Requires: python3 and the AmigaOS NDK headers for the m68k side.
# Note that gen_shadow_layouts.py only treats a field as a pointer when the
# native one is 8 bytes wide, so it needs fixing before it can serve a
# 32bit target.
